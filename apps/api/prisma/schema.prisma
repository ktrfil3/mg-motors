// ─── Prisma Schema — Troller Platform ─────────────────────────────────────────
// Entidades: Vehicle, VehicleVersion, VehicleColor, Dealer, Offer,
//            CreditSimulation, CreditApplication, User, ConsentLog

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ─────────────────────────────────────────────────────────────────────

enum VehicleCategory {
  SUV
  PICKUP
  OFFROAD
  SPORT
  URBAN
}

enum FuelType {
  FLEX
  GASOLINA
  DIESEL
  ELETRICO
  HIBRIDO
}

enum TransmissionType {
  MANUAL
  AUTOMATICO
  CVT
}

enum AmortizationSystem {
  PRICE
  SAC
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  REVIEW
  CANCELLED
}

enum ConsentType {
  CREDIT_CHECK
  MARKETING
  DATA_SHARING
}

enum UserRole {
  CUSTOMER
  DEALER_STAFF
  ADMIN
}

// ─── VEHICLE ───────────────────────────────────────────────────────────────────

model Vehicle {
  id          String          @id @default(uuid())
  slug        String          @unique
  name        String          // Ex: "Troller T4"
  tagline     String?         // Ex: "O rei das trilhas"
  description String?         @db.Text
  category    VehicleCategory
  basePrice   Decimal         @db.Decimal(12, 2)

  // Specs principais (denormalizadas para performance nas listagens)
  engine      String?         // Ex: "2.0L EcoBoost 250cv"
  fuelType    FuelType        @default(FLEX)
  transmission TransmissionType @default(AUTOMATICO)
  doors       Int             @default(4)
  seats       Int             @default(5)

  // Media
  heroImage   String?         // URL imagem principal
  heroVideo   String?         // URL vídeo placeholder
  model3dUrl  String?         // URL arquivo .glb

  // Estado
  isActive    Boolean         @default(true)
  isFeatured  Boolean         @default(false)
  order       Int             @default(0) // Para ordenação no carrossel

  // Relações
  versions    VehicleVersion[]
  colors      VehicleColor[]
  offers      Offer[]
  applications CreditApplication[]

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([slug])
  @@index([category])
  @@index([isActive, isFeatured])
  @@map("vehicles")
}

model VehicleVersion {
  id          String   @id @default(uuid())
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  name        String   // Ex: "Sport", "Adventure", "Premium"
  slug        String
  price       Decimal  @db.Decimal(12, 2)
  description String?  @db.Text

  // Specs completas da versão
  specs       Json?    // Objeto flexível com todos os dados técnicos

  isActive    Boolean  @default(true)
  order       Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([vehicleId, slug])
  @@map("vehicle_versions")
}

model VehicleColor {
  id          String   @id @default(uuid())
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  name        String   // Ex: "Preto Ônix"
  hexCode     String   // Ex: "#1A1A1A"
  isMetallic  Boolean  @default(false)
  isPremium   Boolean  @default(false) // Cor com custo adicional
  additionalPrice Decimal @default(0) @db.Decimal(10, 2)

  // Imagem do carro nessa cor
  imageUrl    String?

  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())

  @@map("vehicle_colors")
}

// ─── DEALER ────────────────────────────────────────────────────────────────────

model Dealer {
  id          String   @id @default(uuid())
  code        String   @unique // Código interno da concessionária
  name        String
  tradeName   String?  // Nome fantasia

  // Endereço
  address     String
  city        String
  state       String   // UF: SP, RJ, etc.
  cep         String
  country     String   @default("BR")

  // Geolocalização (para busca por proximidade)
  latitude    Float
  longitude   Float

  // Contato
  phone       String?
  whatsapp    String?
  email       String?
  website     String?

  // Horários (JSON para flexibilidade)
  businessHours Json?  // { "seg-sex": "08:00-18:00", "sab": "08:00-13:00" }

  // Serviços
  hasSales    Boolean  @default(true)
  hasService  Boolean  @default(true)
  hasParts    Boolean  @default(false)

  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([state])
  @@index([latitude, longitude])
  @@map("dealers")
}

// ─── OFFER ─────────────────────────────────────────────────────────────────────

model Offer {
  id            String   @id @default(uuid())
  vehicleId     String
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  title         String
  description   String?  @db.Text
  badgeText     String?  // Ex: "Oferta especial", "Últimas unidades"

  // Condições comerciais
  originalPrice Decimal  @db.Decimal(12, 2)
  salePrice     Decimal? @db.Decimal(12, 2)
  discountPct   Float?   // Percentual de desconto
  cashback      Decimal? @db.Decimal(10, 2)

  // Condições de financiamento associadas à oferta
  downPaymentMin  Decimal? @db.Decimal(10, 2)
  installments    Int?
  installmentPrice Decimal? @db.Decimal(10, 2)

  imageUrl      String?
  ctaText       String?  @default("Ver oferta")
  ctaUrl        String?

  // Validade
  startsAt      DateTime
  endsAt        DateTime
  isActive      Boolean  @default(true)
  isFeatured    Boolean  @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([vehicleId, isActive])
  @@index([endsAt])
  @@map("offers")
}

// ─── CREDIT SIMULATION ─────────────────────────────────────────────────────────
// Simulações públicas — sem dados pessoais

model CreditSimulation {
  id                String             @id @default(uuid())
  sessionId         String?            // ID de sessão anônima (cookie)

  vehiclePrice      Decimal            @db.Decimal(12, 2)
  downPayment       Decimal            @db.Decimal(12, 2)
  termMonths        Int
  amortizationSystem AmortizationSystem
  balloonPayment    Decimal?           @db.Decimal(12, 2)
  interestRateMonthly Float            // Taxa mensal usada no cálculo

  // Resultado calculado (snapshot)
  monthlyInstallment Decimal           @db.Decimal(10, 2)
  totalPaid         Decimal            @db.Decimal(12, 2)
  totalInterest     Decimal            @db.Decimal(12, 2)
  cetAnnual         Float              // Custo Efetivo Total anual (estimado)

  createdAt         DateTime           @default(now())

  @@index([sessionId])
  @@map("credit_simulations")
}

// ─── CREDIT APPLICATION ────────────────────────────────────────────────────────
// Consulta real de crédito — dados sensíveis cifrados (LGPD)

model CreditApplication {
  id          String            @id @default(uuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id])
  vehicleId   String
  vehicle     Vehicle           @relation(fields: [vehicleId], references: [id])

  // Dados sensíveis — SEMPRE CIFRADOS com AES-256 antes de persistir
  // Nunca logar estes campos em texto plano
  cpfEncrypted    String        // CPF cifrado
  rendaEncrypted  String        // Renda mensal cifrada
  dadosEncrypted  String        @db.Text // JSON com demais dados pessoais cifrado

  // Resultado do bureau
  status          ApplicationStatus @default(PENDING)
  bureauReference String?       // ID da consulta no bureau externo
  bureauResponse  Json?         // Resposta do bureau (sem dados sensíveis)

  // Score/resultado (sem dados pessoais identificáveis)
  approvedAmount  Decimal?      @db.Decimal(12, 2)
  approvedRate    Float?        // Taxa aprovada
  approvedTerms   Int?          // Prazo aprovado em meses

  // LGPD
  consentLogs     ConsentLog[]

  // Auditoria (sem dados pessoais)
  ipAddress       String?       // Para auditoria (anonimizar em produção)
  userAgent       String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId, status])
  @@index([createdAt])
  @@map("credit_applications")
}

// ─── CONSENT LOG ───────────────────────────────────────────────────────────────
// Registro obrigatório LGPD de todos os consentimentos

model ConsentLog {
  id              String      @id @default(uuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  applicationId   String?
  application     CreditApplication? @relation(fields: [applicationId], references: [id])

  consentType     ConsentType
  consentText     String      @db.Text  // Texto exato que o usuário consentiu
  consentVersion  String      // Versão do texto de consentimento

  // Evidência
  ipAddress       String
  userAgent       String
  consentedAt     DateTime    @default(now())
  revokedAt       DateTime?   // Nulo se ainda ativo

  @@index([userId, consentType])
  @@index([consentedAt])
  @@map("consent_logs")
}

// ─── USER ──────────────────────────────────────────────────────────────────────

model User {
  id              String      @id @default(uuid())
  email           String      @unique
  passwordHash    String      // bcrypt
  role            UserRole    @default(CUSTOMER)

  // Perfil
  firstName       String
  lastName        String
  phone           String?

  // Auth
  refreshToken    String?     // Hash do refresh token
  emailVerified   Boolean     @default(false)
  emailVerifiedAt DateTime?

  // LGPD
  isActive        Boolean     @default(true)
  deletedAt       DateTime?   // Soft delete para retenção LGPD

  // Relações
  applications    CreditApplication[]
  consentLogs     ConsentLog[]

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([email])
  @@map("users")
}
