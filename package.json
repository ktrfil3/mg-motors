{
  "name": "troller-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma digital Troller — site automotivo brasileiro",
  "scripts": {
    "dev": "pnpm --parallel --filter=./apps/* dev",
    "build": "pnpm --filter=./packages/* build && pnpm --filter=./apps/* build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter=api exec prisma migrate dev",
    "db:seed": "pnpm --filter=api exec prisma db seed",
    "db:studio": "pnpm --filter=api prisma studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "postinstall": "prisma generate --schema=apps/api/prisma/schema.prisma || true"
  },
  "prisma": {
    "schema": "apps/api/prisma/schema.prisma"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}